{
    "family": "ml-research-agent",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::813343076280:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "ml-research-agent",
            "image": "813343076280.dkr.ecr.us-east-1.amazonaws.com/ml-research-agent:latest",
            "portMappings": [
                {
                    "containerPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ml-research-agent",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}